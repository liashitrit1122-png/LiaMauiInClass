<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LiaMauiInClass.Views.SignInPage"
             Title="SignInPage"
             xmlns:views="clr-namespace:LiaMauiInClass.Views"
             x:DataType="views:SignInPage">



    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="Purple"/>
            <GradientStop Offset="0.5" Color="#3a7bd5"/>
            <GradientStop Offset="1.0" Color="LightCyan"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout
        Padding="30"
        VerticalOptions="Center">

        <Border
          Padding="10"
          Stroke="#ccc"
          StrokeShape="RoundRectangle 8"
          StrokeThickness="1">

            <Entry
               Keyboard="Email"
               FontSize="18"
               Placeholder="Email"
               TextColor="Wheat"
               ReturnType="Go"
               Text="{Binding UserName}"/>
            
        </Border>

        <Border
         Stroke="#ccc"
         StrokeShape="RoundRectangle 8"
         StrokeThickness="1">

            <Grid
            Padding="10"
            ColumnDefinitions="*,Auto"
            VerticalOptions="Center">

                <Entry               
                   BackgroundColor="Transparent"
                   FontSize="18"
                   IsPassword="{Binding EntryAsPassword}"
                   Placeholder="סיסמה"
                   TextColor="Wheat"
                   VerticalOptions="Center"
                   Text="{Binding UserPassword}"/>

                <Button                  
                   Margin="5,0,0,0"
                   BackgroundColor="Transparent"
                   FontSize="24"
                   HorizontalOptions="End"
                   Text="&#xe8f5;"
                   FontFamily="MaterialIcons"
                   TextColor="White"
                   VerticalOptions="Center"
                   Clicked="TogglePassordButton_Clicked"/>
            </Grid>
        </Border>


        <!--כפתור כניסה-->
        <Button
            CornerRadius="8"
            FontSize="18"
            HeightRequest="50"
            Text="חיבור"
            TextColor="White"
            IsEnabled="{Binding IsSignInButtonEnabled}" 
            Clicked="OnSignInButtonClick"/>


        <!-- שגיאה-->
        <Label
            FontSize="45"
            HorizontalTextAlignment="Center"
            IsVisible="{Binding SignInMessageVisible}"
            Text="{Binding MessageText}"
            TextColor="{Binding MessageColor}"/>
      
    </VerticalStackLayout>    
</ContentPage>